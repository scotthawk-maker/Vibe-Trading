# ===== Solana Trading Bot — Environment Configuration Template =====
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# Rotate any secret that was previously committed to git history.

# --- Critical secrets ---
HELIUS_API_KEY=your_helius_api_key_here
WALLET_PRIVATE_KEY=your_wallet_private_key_as_json_array_or_base58
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
COINGECKO_API_KEY=your_coingecko_pro_api_key_here

# --- Webhook security ---
# Required: all /api/* and /webhook endpoints reject requests without this.
WEBHOOK_AUTH_TOKEN=generate_a_long_random_secret
# Optional: HMAC-SHA256 signature verification for Helius webhooks.
WEBHOOK_SIGNATURE_SECRET=
# Optional: override the bind address (default 127.0.0.1).
WEBHOOK_BIND_ADDR=127.0.0.1
WEBHOOK_PORT=3000

# --- gmgn-cli ---
# Optional: full path to the gmgn-cli binary (default relies on PATH).
GMGN_CLI_PATH=gmgn-cli

# --- Trading safety parameters ---
MAX_PRICE_IMPACT_PCT=10.0
DUST_THRESHOLD_BASE_UNITS=50000
DRY_RUN=true

# --- Trade sizing ---
TRADE_AMOUNT_LAMPORTS=50000000
TRADE_AMOUNT_SOL_LAMPORTS=50000000
TRADE_AMOUNT_USDC_BASE=10000000
GRID_TRADE_SIZE_SOL=0.02
SLIPPAGE_BPS=50
JITO_TIP_LAMPORTS=100000
MAX_PARALLEL_POSITIONS=1

# --- Strategy ---
STRATEGY=HUNTER
CHECK_INTERVAL_SECS=15
MAX_HOLD_TIME_MINUTES=30

# --- Mints ---
INPUT_MINT=So11111111111111111111111111111111111111112
OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Safety thresholds ---
MIN_LIQUIDITY_USD=3000
MAX_TOP_10_HOLDER_PCT=30
MAX_DEV_TEAM_HOLD_PCT=15
MAX_CREATOR_BALANCE_PCT=10
MAX_SUSPECTED_INSIDER_PCT=15
REQUIRE_SOCIALS=true
MIN_SMART_DEGEN_COUNT=0
MAX_RAT_TRADER_PCT=10
MIN_PROGRESS_PCT=75
MAX_PROGRESS_PCT=90

# --- Exit logic ---
TAKE_PROFIT_PCT=40
STOP_LOSS_PCT=-20
BREAKEVEN_TRIGGER_PCT=10.0
BREAKEVEN_STOP_LOSS_PCT=1.0
MOONBAG_RETAIN_PCT=0
MIN_WHALE_RATING=0

# --- Grid ---
GRID_SPACING_PCT=10.0
GRID_PROFIT_PCT=15.0
GRID_MAX_LEVELS=5

# --- Autonomous ---
MIGRATION_COOLDOWN_SECS=90
MIN_V_DELTA_ENTRY=5.0
MIN_LP_MC_RATIO_ENTRY=0.05
MIN_LP_MC_RATIO_EXIT=0.03

# --- Optional price targets ---
LIMIT_PRICE_USDC=
SELL_SOL_TARGET_PRICE=
BUY_SOL_TARGET_PRICE=

# --- Database ---
DATABASE_PATH=data/trades.db

# --- CoinGecko momentum gates (optional) ---
MIN_GECKO_M5_MOMENTUM_PCT=0.0
MIN_GECKO_BUY_PRESSURE_PCT=50.0